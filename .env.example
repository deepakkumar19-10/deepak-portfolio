# =============================================================================
# DEEPAK KUMAR PORTFOLIO — ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FIREBASE FIRESTORE CONFIGURATION
# (Get these from Firebase Console -> Project Settings -> General -> Web App)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Optional if using EmailJS alongside FormSubmit)
# -----------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# 3. AI AGENT LLM API (Optional Google Gemini API key for live dynamic answers)
# (Get free API key at https://aistudio.google.com/)
# If omitted, the embedded smart rule engine will handle all inquiries.
# -----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 4. WHATSAPP CLOUD API / WEBHOOK (For Twilio / Meta WhatsApp webhook serverless)
# -----------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=deepak_portfolio_webhook_secret_2026
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
